[Unit]
Description=IoT Climate Data Logger Simulator
After=network.target

[Service]
# Type=simple means the service starts immediately as soon as the binary executes
Type=simple
ExecStart=/usr/local/bin/climatelog
# Restart configuration: if the program stops or crashes, turn it back on automatically
Restart=always
RestartSec=5
# Run witn least privilege
User=climatelog
Group=climatelog
# Automatically creates and owns /var/lib/climatelog
StateDirectory=climatelog
StateDirectoryMode=0750

[Install]
# This line tells Linux to launch this service automatically during the system boot sequence
WantedBy=multi-user.target

