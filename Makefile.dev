# Separate features for development proccess. Hide them from end users.

CPPFLAGS += -DCLIMATELOG_DB_FILE=\"./climatelog.db\"
CFLAGS += -Wall -Wextra -Wshadow -Wmissing-declarations -Wmissing-prototypes -g -Og -fsanitize=address,undefined
LDFLAGS += -fsanitize=address,undefined
OBJDIR = dev/obj
TARGET = dev/climatelog

include Makefile

HDRS = $(wildcard include/*.h src/*.h)

# Order-only dependencies
$(TARGET): | dev tags

tags: $(SRCS) $(HDRS)
	ctags $(SRCS) $(HDRS)

dev:
	@mkdir -p $@

.PHONY: run

run: $(TARGET)
	@./$(TARGET)

# Double colons rule, append the target's command.
clean::
	rm -rf dev tags
